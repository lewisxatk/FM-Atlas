                                <Ellipse Width="48" Height="48" Stroke="#52745A" StrokeThickness="1" Canvas.Left="136" Canvas.Top="68"/>
                                <Rectangle Width="92" Height="31" Stroke="#52745A" StrokeThickness="1" Canvas.Left="114" Canvas.Top="0"/>
                                <Rectangle Width="92" Height="31" Stroke="#52745A" StrokeThickness="1" Canvas.Left="114" Canvas.Top="153"/>
                                <ToggleButton Content="ST" Tag="position_st" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="139" Canvas.Top="7" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="AML" Tag="position_aml" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="54" Canvas.Top="34" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="AMC" Tag="position_amc" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="139" Canvas.Top="34" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="AMR" Tag="position_amr" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="224" Canvas.Top="34" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="ML" Tag="position_ml" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="54" Canvas.Top="64" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="MC" Tag="position_mc" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="139" Canvas.Top="64" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="MR" Tag="position_mr" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="224" Canvas.Top="64" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="WBL" Tag="position_wbl" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="0" Canvas.Top="96" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="DM" Tag="position_dm" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="139" Canvas.Top="96" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="WBR" Tag="position_wbr" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="268" Canvas.Top="96" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="DL" Tag="position_dl" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="54" Canvas.Top="123" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="DC" Tag="position_dc" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="139" Canvas.Top="123" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="DR" Tag="position_dr" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="224" Canvas.Top="123" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="SW" Tag="position_sw" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="139" Canvas.Top="145" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                                <ToggleButton Content="GK" Tag="position_gk" Click="PositionButton_Click" IsThreeState="False" Style="{StaticResource PositionRoleButton}" Width="52" Height="28" Canvas.Left="139" Canvas.Top="164" Background="#68717A" Foreground="#F4F5F7" BorderBrush="#89929B" FontSize="16" FontWeight="SemiBold"/>
                            </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="POSITION FAMILIARITY (1–20)" FontSize="8" Foreground="#D9DDE3" Margin="0,5,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="MIN" FontSize="8" Foreground="#D9DDE3"/>
                                <TextBox Style="{StaticResource FilterValue}" Width="96" IsEnabled="True" Text="{Binding DataContext.PositionMinimumText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="MAX" FontSize="8" Foreground="#D9DDE3"/>
                                <TextBox Style="{StaticResource FilterValue}" Width="96" IsEnabled="True" Text="{Binding DataContext.PositionMaximumText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Select one or more roles. Set minimum / maximum familiarity, then choose All or Any above." FontSize="8" Foreground="#D9DDE3" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource FilterPanel}" Margin="0,8,0,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{StaticResource Atlas.Muted}" Margin="2,0,2,6"/>
                <ListBox x:Name="ResultsListBox" Grid.Row="1" ItemsSource="{Binding Results}"
                         MouseDoubleClick="ResultsListBox_MouseDoubleClick"
                         Background="Transparent" BorderThickness="0" MaxHeight="160"
                         ToolTip="Double-click a player result to open its local profile snapshot.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Atlas.Text}" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding EntityType}" Foreground="{StaticResource Atlas.Accent}" FontSize="8" Margin="12,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding SourceId}" Foreground="{StaticResource Atlas.Subtle}" FontFamily="Consolas" FontSize="8"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock Text="ACTIVE LOCAL INDEX · LIVE FM27 SNAPSHOT WHEN CONNECTED · DOUBLE-CLICK TO OPEN PROFILE" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource Atlas.Subtle}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="PresetNameTextBox" Style="{StaticResource FilterValue}" Width="108" Height="29"
                         IsEnabled="True" Text="My search" ToolTip="Name this set of search criteria" Margin="0,0,6,0"/>
                <Button Content="Load preset" Click="LoadPreset_Click" Style="{StaticResource Atlas.ButtonBase}" Margin="0,0,6,0"/>
                <Button Content="Save preset" Click="SavePreset_Click" Style="{StaticResource Atlas.ButtonBase}" Margin="0,0,8,0"/>
                <Button Content="Clear" Click="ClearFilters_Click" Style="{StaticResource Atlas.ButtonBase}" Margin="0,0,6,0"/>
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Style="{StaticResource Atlas.ButtonBase}" Margin="0,0,6,0"/>
                <Button Content="OK / Search" Click="Search_Click" IsDefault="True" Style="{StaticResource Atlas.PrimaryButton}" MinWidth="78"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
