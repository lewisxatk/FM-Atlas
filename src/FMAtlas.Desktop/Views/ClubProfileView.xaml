<UserControl x:Class="FMAtlas.Desktop.Views.ClubProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Atlas.Canvas}"
             Foreground="{StaticResource Atlas.Text}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CLUB PROFILE" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Atlas.Accent}"/>
                <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="30" Foreground="{StaticResource Atlas.Text}" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Atlas.Muted}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Atlas.ProfilePanel}" Padding="14" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="FOUNDED" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/><TextBlock Text="{Binding FoundedText}" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Atlas.Text}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="REPUTATION" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/><TextBlock Text="{Binding ReputationText}" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Atlas.Text}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="STADIUM" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/><TextBlock Text="{Binding CapacityText}" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Atlas.Text}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource Atlas.Border}" BorderThickness="0,0,0,1" Padding="0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Content="{Binding Name}"
                                Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Name}" Margin="0,0,5,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Atlas.ProfileTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Atlas.AccentSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Atlas.Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Atlas.ProfilePanel}" Padding="16">
                <StackPanel>
                    <Border Height="116" Background="#151515" BorderBrush="{StaticResource Atlas.Border}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Image Source="{Binding ClubLogoUri}" Stretch="Uniform"/>
                            <TextBlock Text="CLUB CREST / BADGE" Foreground="{StaticResource Atlas.Subtle}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoClubLogo, Converter={StaticResource Atlas.BooleanToVisibility}}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="19" Foreground="{StaticResource Atlas.Text}" Margin="0,13,0,5"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource Atlas.Muted}" TextWrapping="Wrap"/>
                    <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,13,0,11"/>
                    <TextBlock Text="STADIUM" FontSize="9" Foreground="{StaticResource Atlas.Accent}"/>
                    <TextBlock Text="{Binding StadiumText}" FontSize="11" Foreground="{StaticResource Atlas.Text}" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding CapacityText}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Atlas.Muted}"/>
                    <TextBlock Text="{Binding OwnershipText, StringFormat=Ownership · {0}}" Style="{StaticResource Atlas.ProfileInfoText}" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding AverageAttendanceText, StringFormat=Average attendance · {0}}" Style="{StaticResource Atlas.ProfileInfoText}"/>
                    <TextBlock Text="{Binding ChairpersonText, StringFormat=Chairperson · {0}}" Style="{StaticResource Atlas.ProfileInfoText}"/>
                    <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,13,0,11"/>
                    <TextBlock Text="DATA STATUS" FontSize="9" Foreground="{StaticResource Atlas.Accent}"/>
                    <TextBlock Text="LIVE SNAPSHOT · READ-ONLY" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Atlas.Muted}" Margin="0,7,0,0"/>
                    <TextBlock Text="Only source-backed values are shown. Missing club records are not inferred." FontSize="9" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Atlas.ProfilePanel}" Padding="20">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
                        <TextBlock Text="{Binding SelectedSection}" FontFamily="Georgia" FontSize="24" Foreground="{StaticResource Atlas.Text}"/>
                        <TextBlock Text="{Binding SectionDescription}" FontSize="11" Foreground="{StaticResource Atlas.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="SquadPlayersListBox"
                                 ItemsSource="{Binding SquadPlayers}"
                                 Visibility="{Binding IsSquadsSection, Converter={StaticResource Atlas.BooleanToVisibility}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="SquadPlayersListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,9"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="Background" Value="{StaticResource Atlas.SurfaceRaised}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Atlas.Border}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource Atlas.Text}"/>
                                            <TextBlock Text="{Binding Identity.SourceId}" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource Atlas.Subtle}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="OPEN PLAYER ↗" FontSize="8" Foreground="{StaticResource Atlas.Accent}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox x:Name="ClubStaffListBox"
                                 ItemsSource="{Binding ClubStaff}"
                                 Visibility="{Binding IsStaffSection, Converter={StaticResource Atlas.BooleanToVisibility}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="ClubStaffListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,9"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="Background" Value="{StaticResource Atlas.SurfaceRaised}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Atlas.Border}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource Atlas.Text}"/>
                                            <TextBlock Text="{Binding Identity.SourceId}" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource Atlas.Subtle}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="OPEN STAFF ↗" FontSize="8" Foreground="{StaticResource Atlas.Accent}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ItemsControl ItemsSource="{Binding SectionRows}"
                                      Visibility="{Binding IsOtherProfileSection, Converter={StaticResource Atlas.BooleanToVisibility}}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{StaticResource Atlas.Border}" BorderThickness="0,0,0,1" Padding="5,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{StaticResource Atlas.Text}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="11" Foreground="{StaticResource Atlas.Text}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding EvidenceText}" FontSize="9" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SectionEmptyText}" Visibility="{Binding HasSectionEmptyText, Converter={StaticResource Atlas.BooleanToVisibility}}" Foreground="{StaticResource Atlas.Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" Margin="4,8,4,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>