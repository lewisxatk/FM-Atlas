<UserControl x:Class="FMAtlas.Desktop.Views.StaffProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Atlas.Canvas}"
             Foreground="{StaticResource Atlas.Text}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">
    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="STAFF PROFILE" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Atlas.Accent}"/>
                <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="30" Foreground="{StaticResource Atlas.Text}" Margin="0,5,0,2"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Atlas.Muted}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Atlas.ProfilePanel}" Padding="14" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="AGE" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/><TextBlock Text="{Binding AgeText}" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Atlas.Text}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="CA" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/><TextBlock Text="{Binding CaText}" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Atlas.Text}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="PA" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/><TextBlock Text="{Binding PaText}" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Atlas.Text}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{StaticResource Atlas.Border}" BorderThickness="0,0,0,1" Padding="0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Content="{Binding Name}"
                                Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Name}" Margin="0,0,5,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Atlas.ProfileTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Atlas.AccentSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Atlas.Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Atlas.ProfilePanel}" Padding="16">
                <StackPanel>
                    <TextBlock Text="STAFF INFORMATION" FontSize="9" Foreground="{StaticResource Atlas.Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding GenderInfoText}" Style="{StaticResource Atlas.ProfileInfoText}"/>
                    <TextBlock Text="{Binding NationalityInfoText}" Style="{StaticResource Atlas.ProfileInfoText}"/>
                    <TextBlock Text="{Binding SectionEmptyText}" FontSize="9" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap" Margin="0,15,0,0"/>
                    <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,15,0,12"/>
                    <TextBlock Text="DATA STATUS" FontSize="9" Foreground="{StaticResource Atlas.Accent}"/>
                    <TextBlock Text="READ-ONLY SNAPSHOT" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Atlas.Muted}" Margin="0,8,0,0"/>
                    <TextBlock Text="Editing and live save remain disabled until field-level verification is complete." FontSize="9" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Atlas.ProfilePanel}" Padding="20">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
                        <TextBlock Text="{Binding SelectedSection}" FontFamily="Georgia" FontSize="24" Foreground="{StaticResource Atlas.Text}"/>
                        <TextBlock Text="{Binding SectionDescription}" FontSize="11" Foreground="{StaticResource Atlas.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Grid>
                        <ItemsControl ItemsSource="{Binding SectionRows}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{StaticResource Atlas.Border}" BorderThickness="0,0,0,1" Padding="5,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{StaticResource Atlas.Text}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="11" Foreground="{StaticResource Atlas.Text}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding EvidenceText}" FontSize="9" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SectionEmptyText}" Visibility="{Binding HasSectionEmptyText, Converter={StaticResource Atlas.BooleanToVisibility}}" Foreground="{StaticResource Atlas.Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" Margin="4,8,4,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>