<Application x:Class="FMAtlas.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="Atlas.BooleanToVisibility"/>
        <SolidColorBrush x:Key="Atlas.Canvas" Color="#070707"/>
        <SolidColorBrush x:Key="Atlas.Sidebar" Color="#090909"/>
        <SolidColorBrush x:Key="Atlas.Surface" Color="#0E0E0E"/>
        <SolidColorBrush x:Key="Atlas.SurfaceRaised" Color="#141414"/>
        <SolidColorBrush x:Key="Atlas.Border" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="Atlas.Text" Color="#F2F2EF"/>
        <SolidColorBrush x:Key="Atlas.Muted" Color="#97968F"/>
        <SolidColorBrush x:Key="Atlas.Subtle" Color="#66655F"/>
        <SolidColorBrush x:Key="Atlas.Accent" Color="#FF6A2A"/>
        <SolidColorBrush x:Key="Atlas.AccentSoft" Color="#2A160F"/>

        
        <!-- HUD palette and tiled background from the supplied restyle. -->
        <SolidColorBrush x:Key="Atlas.BracketBrush" Color="#F4F4F2"/>
        <SolidColorBrush x:Key="Atlas.BorderBright" Color="#6A6A66"/>
        <SolidColorBrush x:Key="Atlas.Panel" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="Atlas.Live" Color="#35E08A"/>
        <DrawingBrush x:Key="Atlas.GridBackdrop" TileMode="Tile"
                      Viewport="0,0,44,44" ViewportUnits="Absolute"
                      Viewbox="0,0,44,44" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#070707">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,44,44"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="#0FFFFFFF" Thickness="1"/></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="44,0"/>
                                <LineGeometry StartPoint="0,0" EndPoint="0,44"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="#2EFFFFFF" Thickness="1"/></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="19,22" EndPoint="25,22"/>
                                <LineGeometry StartPoint="22,19" EndPoint="22,25"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="Atlas.Bracket" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Atlas.BracketBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Square"/>
            <Setter Property="StrokeEndLineCap" Value="Square"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

<Style x:Key="Atlas.ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
            <Setter Property="Background" Value="{StaticResource Atlas.SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Atlas.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                            </Border>
                            <Path x:Name="CornerTL" Style="{StaticResource Atlas.Bracket}" Data="M1,9 L1,1 L9,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-1,0,0"/>
                            <Path x:Name="CornerTR" Style="{StaticResource Atlas.Bracket}" Data="M1,1 L9,1 L9,9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"/>
                            <Path x:Name="CornerBL" Style="{StaticResource Atlas.Bracket}" Data="M1,1 L1,9 L9,9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-1,0,0,-1"/>
                            <Path x:Name="CornerBR" Style="{StaticResource Atlas.Bracket}" Data="M9,1 L9,9 L1,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Atlas.BorderBright}"/>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1C1C1C"/>
                                <Setter TargetName="CornerTL" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerTR" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerBL" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerBR" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Atlas.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Atlas.ButtonBase}">
            <Setter Property="Foreground" Value="#160D08"/>
            <Setter Property="Background" Value="{StaticResource Atlas.Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Atlas.Accent}"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Path x:Name="CornerTL" Style="{StaticResource Atlas.Bracket}" Data="M1,9 L1,1 L9,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0" Opacity="0.9"/>
                            <Path x:Name="CornerTR" Style="{StaticResource Atlas.Bracket}" Data="M1,1 L9,1 L9,9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Opacity="0.9"/>
                            <Path x:Name="CornerBL" Style="{StaticResource Atlas.Bracket}" Data="M1,1 L1,9 L9,9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4" Opacity="0.9"/>
                            <Path x:Name="CornerBR" Style="{StaticResource Atlas.Bracket}" Data="M9,1 L9,9 L1,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Opacity="0.9"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF8450"/>
                                <Setter TargetName="CornerTL" Property="Margin" Value="-6,-6,0,0"/>
                                <Setter TargetName="CornerTR" Property="Margin" Value="0,-6,-6,0"/>
                                <Setter TargetName="CornerBL" Property="Margin" Value="-6,0,0,-6"/>
                                <Setter TargetName="CornerBR" Property="Margin" Value="0,0,-6,-6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Atlas.NavButton" TargetType="Button" BasedOn="{StaticResource Atlas.ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <Rectangle x:Name="NavTick" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Atlas.Accent}" Opacity="0" IsHitTestVisible="False"/>
                            <Path x:Name="CornerTL" Style="{StaticResource Atlas.Bracket}" Data="M1,9 L1,1 L9,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-1,0,0" Opacity="0"/>
                            <Path x:Name="CornerBR" Style="{StaticResource Atlas.Bracket}" Data="M9,1 L9,9 L1,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#151515"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#2A2A2A"/>
                                <Setter TargetName="NavTick" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerTL" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerBR" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#211711"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="Atlas.TextBoxTemplate" TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Atlas.BorderBright}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Atlas.Accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Atlas.TextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="BorderBrush" Value="{StaticResource Atlas.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{StaticResource Atlas.Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Atlas.Accent}"/>
            <Setter Property="Template" Value="{StaticResource Atlas.TextBoxTemplate}"/>
        </Style>

        <Style x:Key="Atlas.Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Atlas.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Atlas.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="17"/>
        </Style>

        <Style x:Key="Atlas.ProfilePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Atlas.Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Atlas.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="Atlas.ProfileInfoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Atlas.Muted}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="Atlas.HudLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource Atlas.Muted}"/>
        </Style>
        <Style x:Key="Atlas.ProfileTabButton" TargetType="Button" BasedOn="{StaticResource Atlas.ButtonBase}">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Atlas.Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Path x:Name="CornerTL" Style="{StaticResource Atlas.Bracket}" Data="M1,9 L1,1 L9,1" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-1,0,0" Opacity="0"/>
                            <Path x:Name="CornerTR" Style="{StaticResource Atlas.Bracket}" Data="M1,1 L9,1 L9,9" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" Opacity="0"/>
                            <Path x:Name="CornerBL" Style="{StaticResource Atlas.Bracket}" Data="M1,1 L1,9 L9,9" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-1,0,0,-1" Opacity="0"/>
                            <Path x:Name="CornerBR" Style="{StaticResource Atlas.Bracket}" Data="M9,1 L9,9 L1,9" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#181818"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter TargetName="CornerTL" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerTR" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerBL" Property="Opacity" Value="1"/>
                                <Setter TargetName="CornerBR" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    
        <Style x:Key="Atlas.ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Atlas.ScrollThumb" TargetType="Thumb">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#3C3C3C" CornerRadius="1" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#8A8A86"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource Atlas.Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <ControlTemplate x:Key="Atlas.VerticalScrollBar" TargetType="ScrollBar">
            <Border Background="#0A0A0A"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Atlas.ScrollPageButton}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource Atlas.ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Atlas.ScrollPageButton}"/></Track.IncreaseRepeatButton></Track></Border>
        </ControlTemplate>
        <ControlTemplate x:Key="Atlas.HorizontalScrollBar" TargetType="ScrollBar">
            <Border Background="#0A0A0A"><Track x:Name="PART_Track" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Atlas.ScrollPageButton}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource Atlas.ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Atlas.ScrollPageButton}"/></Track.IncreaseRepeatButton></Track></Border>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template" Value="{StaticResource Atlas.VerticalScrollBar}"/>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="Template" Value="{StaticResource Atlas.HorizontalScrollBar}"/></Trigger></Style.Triggers>
        </Style>
            <Style x:Key="Atlas.LiveStatusDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="#8B6B4D"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LiveSessionActive}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Atlas.Live}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
