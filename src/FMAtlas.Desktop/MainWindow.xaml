<Window x:Class="FMAtlas.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FM Atlas"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Atlas.Canvas}"
        Foreground="{StaticResource Atlas.Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact navigation rail. Search deliberately does not appear here. -->
        <Border Grid.Column="0"
                Grid.RowSpan="2"
                Background="{StaticResource Atlas.Sidebar}"
                BorderBrush="{StaticResource Atlas.Border}"
                BorderThickness="0,0,1,0"
                Padding="15,20,15,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#21140F" BorderBrush="#4B281B" BorderThickness="1">
                        <TextBlock Text="FM" Foreground="{StaticResource Atlas.Accent}" FontFamily="Georgia" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FM ATLAS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Atlas.Text}"/>
                        <TextBlock Text="FOOTBALL MANAGER EDITOR" FontSize="8" Foreground="{StaticResource Atlas.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="WORKSPACE" FontSize="9" Foreground="{StaticResource Atlas.Subtle}" Margin="9,0,0,10"/>
                    <Button Style="{StaticResource Atlas.NavButton}" Background="#1B1511" BorderBrush="#352219" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Accent}" FontSize="14" Width="25"/>
                            <TextBlock Text="Dashboard" Foreground="{StaticResource Atlas.Text}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" Margin="0,0,0,4" ToolTip="In Progress — waiting for the live data provider.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Players" FontSize="12"/>
                            <TextBlock Text="IN PROGRESS" FontSize="8" Foreground="{StaticResource Atlas.Subtle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" Margin="0,0,0,4" ToolTip="In Progress — staff data provider not implemented.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Staff" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" Margin="0,0,0,4" ToolTip="In Progress — club data provider not implemented.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Clubs" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" Margin="0,0,0,4" ToolTip="In Progress — save manager not implemented.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Save Manager" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="TOOLS" FontSize="9" Foreground="{StaticResource Atlas.Subtle}" Margin="9,22,0,10"/>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" ToolTip="In Progress — deferred until the basic editor works.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Squad &amp; Tactics" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" ToolTip="In Progress — advanced scouting is deferred.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Recruitment" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,0,0,12"/>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" ToolTip="In Progress — settings are not implemented yet.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Settings" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="FRESH FOUNDATION · 001" FontSize="8" Foreground="{StaticResource Atlas.Subtle}" Margin="10,13,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Global header: quick search, advanced search, save actions and prominent Load Game. -->
        <Border Grid.Column="1"
                Grid.Row="0"
                Background="#090909"
                BorderBrush="{StaticResource Atlas.Border}"
                BorderThickness="0,0,0,1"
                Padding="25,13,25,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="WORKSPACE" FontSize="9" Foreground="{StaticResource Atlas.Subtle}"/>
                    <TextBlock Text="  /  " FontSize="9" Foreground="{StaticResource Atlas.Subtle}"/>
                    <TextBlock Text="DASHBOARD" FontSize="9" Foreground="{StaticResource Atlas.Text}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#8B6B4D" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="10" Foreground="{StaticResource Atlas.Muted}"/>
                </StackPanel>

                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#111111" BorderBrush="{StaticResource Atlas.Border}" BorderThickness="1" CornerRadius="7" Padding="11,0" Height="37" Margin="0,0,9,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBox Style="{StaticResource Atlas.TextBox}" Text="Quick search will be available when a career is loaded" IsEnabled="False" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource Atlas.ButtonBase}" IsEnabled="False" Margin="0,0,8,0" Height="37" ToolTip="In Progress — requires a verified search index.">
                        <TextBlock Text="Advanced Search"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Atlas.ButtonBase}" IsEnabled="False" Margin="0,0,8,0" Height="37" ToolTip="In Progress — saves the local Atlas database.">
                        <TextBlock Text="Save Atlas"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource Atlas.ButtonBase}" IsEnabled="False" Margin="0,0,10,0" Height="37" ToolTip="In Progress — live career writing is not enabled.">
                        <TextBlock Text="Save Changes"/>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource Atlas.PrimaryButton}" Height="37" MinWidth="118" Command="{Binding LoadGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Load Game"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Main dashboard. All values are real application states, not demo data. -->
        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,25,26,28">
                <Grid Margin="0,0,0,19">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FM Atlas" FontFamily="Georgia" FontSize="31" Foreground="{StaticResource Atlas.Text}"/>
                        <TextBlock Text="Your Football Manager workspace." FontSize="12" Foreground="{StaticResource Atlas.Muted}" Margin="1,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#17110E" BorderBrush="#3D261B" BorderThickness="1" CornerRadius="6" Padding="10,7" VerticalAlignment="Center">
                        <TextBlock Text="NEW FOUNDATION" FontSize="8" Foreground="{StaticResource Atlas.Accent}"/>
                    </Border>
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,0,15">
                    <Border Style="{StaticResource Atlas.Card}" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="GAME CONNECTION" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Atlas.Text}" Margin="0,13,0,3"/>
                            <TextBlock Text="Windows process check only" FontSize="10" Foreground="{StaticResource Atlas.Subtle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Atlas.Card}" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE CAREER" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Text="No career loaded" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Atlas.Text}" Margin="0,13,0,3"/>
                            <TextBlock Text="Live data import · In Progress" FontSize="10" Foreground="{StaticResource Atlas.Subtle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Atlas.Card}" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="PLAYER RECORDS" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Text="—" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Atlas.Text}" Margin="0,9,0,3"/>
                            <TextBlock Text="No records imported" FontSize="10" Foreground="{StaticResource Atlas.Subtle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Atlas.Card}">
                        <StackPanel>
                            <TextBlock Text="PENDING EDITS" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Text="0" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Atlas.Text}" Margin="0,9,0,3"/>
                            <TextBlock Text="Nothing has been changed" FontSize="10" Foreground="{StaticResource Atlas.Subtle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Atlas.Card}" Margin="0,0,10,0" MinHeight="245">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <TextBlock Text="YOUR WORKSPACE" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                                <TextBlock Grid.Column="1" Text="01 / 04" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Atlas.Subtle}"/>
                            </Grid>
                            <TextBlock Text="A clean start." FontFamily="Georgia" FontSize="25" Foreground="{StaticResource Atlas.Text}"/>
                            <TextBlock Text="Connect to your running FM27 career to begin loading real player, staff and club information. Nothing is shown until it has been read and verified."
                                       TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource Atlas.Muted}" Margin="0,9,12,18"/>
                            <Border Background="#17110E" BorderBrush="#3A251A" BorderThickness="1" CornerRadius="7" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="NEXT CONNECTION CHECK" FontSize="8" Foreground="{StaticResource Atlas.Accent}"/>
                                    <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Atlas.Text}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Atlas.Card}" MinHeight="245">
                        <StackPanel>
                            <TextBlock Text="DEVELOPMENT STATUS" FontSize="9" Foreground="{StaticResource Atlas.Muted}" Margin="0,0,0,16"/>
                            <StackPanel Margin="0,0,0,13">
                                <TextBlock Text="01  ·  Application foundation" FontSize="12" Foreground="{StaticResource Atlas.Text}"/>
                                <TextBlock Text="In Progress" FontSize="10" Foreground="{StaticResource Atlas.Accent}" Margin="18,4,0,0"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,0,0,13"/>
                            <StackPanel Margin="0,0,0,13">
                                <TextBlock Text="02  ·  Live save connection" FontSize="12" Foreground="{StaticResource Atlas.Text}"/>
                                <TextBlock Text="In Progress" FontSize="10" Foreground="{StaticResource Atlas.Muted}" Margin="18,4,0,0"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,0,0,13"/>
                            <StackPanel Margin="0,0,0,13">
                                <TextBlock Text="03  ·  Player data and editor" FontSize="12" Foreground="{StaticResource Atlas.Text}"/>
                                <TextBlock Text="Not started" FontSize="10" Foreground="{StaticResource Atlas.Muted}" Margin="18,4,0,0"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,0,0,13"/>
                            <StackPanel>
                                <TextBlock Text="04  ·  Staff, clubs and advanced search" FontSize="12" Foreground="{StaticResource Atlas.Text}"/>
                                <TextBlock Text="Not started" FontSize="10" Foreground="{StaticResource Atlas.Muted}" Margin="18,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding LastAction}" FontSize="10" Foreground="{StaticResource Atlas.Subtle}" Margin="2,15,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
