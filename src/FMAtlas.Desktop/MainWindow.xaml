<Window x:Class="FMAtlas.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FM Atlas"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Atlas.Canvas}"
        Foreground="{StaticResource Atlas.Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact navigation rail. Search deliberately does not appear here. -->
        <Border Grid.Column="0"
                Grid.RowSpan="2"
                Background="{StaticResource Atlas.Sidebar}"
                BorderBrush="{StaticResource Atlas.Border}"
                BorderThickness="0,0,1,0"
                Padding="15,20,15,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#21140F" BorderBrush="#4B281B" BorderThickness="1">
                        <TextBlock Text="FM" Foreground="{StaticResource Atlas.Accent}" FontFamily="Georgia" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FM ATLAS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Atlas.Text}"/>
                        <TextBlock Text="FOOTBALL MANAGER EDITOR" FontSize="8" Foreground="{StaticResource Atlas.Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="WORKSPACE" FontSize="9" Foreground="{StaticResource Atlas.Subtle}" Margin="9,0,0,10"/>
                    <Button Style="{StaticResource Atlas.NavButton}" Background="#1B1511" BorderBrush="#352219" Margin="0,0,0,4" Tag="Dashboard" Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Accent}" FontSize="14" Width="25"/>
                            <TextBlock Text="Dashboard" Foreground="{StaticResource Atlas.Text}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" Margin="0,0,0,4" Tag="Players" Click="NavigationButton_Click" ToolTip="Browse player records from the active career or imported data.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Players" FontSize="12"/>
                            <TextBlock Text="IN PROGRESS" FontSize="8" Foreground="{StaticResource Atlas.Subtle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" Margin="0,0,0,4" Tag="Staff" Click="NavigationButton_Click" ToolTip="Browse staff and coach records.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Staff" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" Margin="0,0,0,4" Tag="Clubs" Click="NavigationButton_Click" ToolTip="Browse club records and full club profiles.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Clubs" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" Margin="0,0,0,4" Tag="Save Manager" Click="NavigationButton_Click" ToolTip="Open the local save/data workspace.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Save Manager" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="TOOLS" FontSize="9" Foreground="{StaticResource Atlas.Subtle}" Margin="9,22,0,10"/>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" ToolTip="In Progress — deferred until the basic editor works.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Squad &amp; Tactics" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Atlas.NavButton}" IsEnabled="False" ToolTip="In Progress — advanced scouting is deferred.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Recruitment" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,0,0,12"/>
                    <Button Style="{StaticResource Atlas.NavButton}" Tag="Settings" Click="NavigationButton_Click" ToolTip="Open FM Atlas settings and data preferences.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="14" Width="25"/>
                            <TextBlock Text="Settings" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="FM ATLAS DESKTOP" FontSize="8" Foreground="{StaticResource Atlas.Subtle}" Margin="10,13,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Global header: quick search, local Atlas save, live-save placeholders and process detection. -->
        <Border Grid.Column="1"
                Grid.Row="0"
                Background="#090909"
                BorderBrush="{StaticResource Atlas.Border}"
                BorderThickness="0,0,0,1"
                Padding="25,13,25,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="WORKSPACE" FontSize="9" Foreground="{StaticResource Atlas.Subtle}"/>
                    <TextBlock Text="  /  " FontSize="9" Foreground="{StaticResource Atlas.Subtle}"/>
                    <TextBlock Text="DASHBOARD" FontSize="9" Foreground="{StaticResource Atlas.Text}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#8B6B4D" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="10" Foreground="{StaticResource Atlas.Muted}"/>
                    <CheckBox Content="Include women"
                              IsChecked="{Binding IncludeWomenPlayers, Mode=TwoWay}"
                              Foreground="{StaticResource Atlas.Muted}"
                              FontSize="9"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="Off by default. Includes women when enabled. Records with missing/unknown gender stay visible and cannot be filtered reliably."/>
                </StackPanel>

                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#111111" BorderBrush="{StaticResource Atlas.Border}" BorderThickness="1" CornerRadius="7" Padding="11,0" Height="37" Margin="0,0,9,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Atlas.Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBox x:Name="QuickSearchTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource Atlas.TextBox}"
                                     Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Quick Search searches records already imported into FM Atlas."/>
                            <Popup PlacementTarget="{Binding ElementName=QuickSearchTextBox}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsQuickSearchOpen, Mode=TwoWay}">
                                <Border Width="440"
                                        MaxHeight="330"
                                        Background="#101010"
                                        BorderBrush="{StaticResource Atlas.Border}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding QuickSearchMessage}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource Atlas.Muted}"
                                                   Margin="2,0,2,9"/>
                                        <ListBox x:Name="QuickSearchResultsListBox" ItemsSource="{Binding QuickSearchResults}" MouseDoubleClick="QuickSearchResults_MouseDoubleClick"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 MaxHeight="270"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="7,6"/>
                                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                                    <Setter Property="Background" Value="#171717"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{StaticResource Atlas.Text}"/>
                                                            <TextBlock Text="{Binding SourceId}" FontSize="8" FontFamily="Consolas" Foreground="{StaticResource Atlas.Subtle}" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding EntityType}"
                                                                   FontSize="8"
                                                                   Foreground="{StaticResource Atlas.Accent}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource Atlas.ButtonBase}" Click="AdvancedSearchButton_Click" Margin="0,0,8,0" Height="37" ToolTip="Open the FMRTE-style filter workspace. Only implemented fields can be queried.">
                        <TextBlock Text="Advanced Search"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Atlas.ButtonBase}" Click="ImportPlayerExportButton_Click" Margin="0,0,8,0" Height="37" ToolTip="Import a compatible FM27 player-list CSV. It must include Player or Name and Unique ID columns. This reads the export file only; it does not load or modify the live career.">
                        <TextBlock Text="Import CSV"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource Atlas.ButtonBase}" Command="{Binding SaveAtlasCommand}" Margin="0,0,8,0" Height="37" ToolTip="Creates or verifies the local FM Atlas database.">
                        <TextBlock Text="Save Atlas"/>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource Atlas.ButtonBase}" IsEnabled="False" Margin="0,0,8,0" Height="37" ToolTip="Read-only live session. Editing and saving remain locked until FM Atlas independently verifies every write field, read-back and undo path.">
                        <TextBlock Text="Save Live Changes"/>
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource Atlas.PrimaryButton}" Height="37" MinWidth="132" Command="{Binding LoadGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Load Game"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Main dashboard. All values are real application states, not demo data. -->
        <TabControl x:Name="WorkspaceTabControl"
                    Grid.Column="1"
                    Grid.Row="1"
                    Background="{StaticResource Atlas.Canvas}"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource Atlas.Muted}"/>
                    <Setter Property="Background" Value="{StaticResource Atlas.Surface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Atlas.Border}"/>
                    <Setter Property="Padding" Value="12,7"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6,6,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Atlas.AccentSoft}"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Atlas.Accent}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Atlas.Text}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Atlas.Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,25,26,28">
                <Grid Margin="0,0,0,19">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FM Atlas" FontFamily="Georgia" FontSize="31" Foreground="{StaticResource Atlas.Text}"/>
                        <TextBlock Text="Manage the active career, player records, staff and clubs." FontSize="12" Foreground="{StaticResource Atlas.Muted}" Margin="1,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#17110E" BorderBrush="#3D261B" BorderThickness="1" CornerRadius="6" Padding="10,7" VerticalAlignment="Center">
                        <TextBlock Text="CAREER WORKSPACE" FontSize="8" Foreground="{StaticResource Atlas.Accent}"/>
                    </Border>
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,0,15">
                    <Border Style="{StaticResource Atlas.Card}" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="GAME CONNECTION" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Atlas.Text}" Margin="0,13,0,3"/>
                            <TextBlock Text="Live career session · exact build only" FontSize="10" Foreground="{StaticResource Atlas.Subtle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Atlas.Card}" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE CAREER" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Atlas.Text}" Margin="0,13,0,3"/>
                            <TextBlock Text="{Binding ConnectionDetail}" FontSize="10" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap" MaxHeight="38"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Atlas.Card}" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="LIVE / LATEST PLAYER IMPORT" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Text="{Binding LastImportCountText}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Atlas.Text}" Margin="0,9,0,3"/>
                            <TextBlock Text="{Binding LastImportStatusText}" FontSize="10" Foreground="{StaticResource Atlas.Subtle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Atlas.Card}">
                        <StackPanel>
                            <TextBlock Text="LIVE WRITE STATUS" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Text="DISABLED" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Atlas.Text}" Margin="0,9,0,3"/>
                            <TextBlock Text="Read-only until write/read-back checks pass" FontSize="10" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Atlas.Card}" Margin="0,0,10,0" MinHeight="245">
                        <StackPanel>
                            <TextBlock Text="CURRENT CAREER" FontSize="9" Foreground="{StaticResource Atlas.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontFamily="Georgia" FontSize="24" Foreground="{StaticResource Atlas.Text}"/>
                            <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap" FontSize="11" LineHeight="18" Foreground="{StaticResource Atlas.Muted}" Margin="0,7,0,15"/>
                            <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,0,0,13"/>
                            <TextBlock Text="LIVE RECORD INDEX" FontSize="9" Foreground="{StaticResource Atlas.Accent}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PLAYERS" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/>
                                    <TextBlock Text="{Binding LivePlayerCount}" FontFamily="Consolas" FontSize="22" Foreground="{StaticResource Atlas.Text}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="STAFF" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/>
                                    <TextBlock Text="{Binding LiveStaffCount}" FontFamily="Consolas" FontSize="22" Foreground="{StaticResource Atlas.Text}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CLUBS" FontSize="8" Foreground="{StaticResource Atlas.Muted}"/>
                                    <TextBlock Text="{Binding LiveClubCount}" FontFamily="Consolas" FontSize="22" Foreground="{StaticResource Atlas.Text}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Double-click a result to open its profile in a new workspace tab. Search is limited to records currently imported into FM Atlas."
                                       FontSize="9" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Atlas.Card}" MinHeight="245">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" FontSize="9" Foreground="{StaticResource Atlas.Muted}" Margin="0,0,0,13"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Grid.Row="0" Content="Players" Tag="Players" Click="NavigationButton_Click" Style="{StaticResource Atlas.ButtonBase}" HorizontalContentAlignment="Left" Margin="0,0,6,7"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="Staff" Tag="Staff" Click="NavigationButton_Click" Style="{StaticResource Atlas.ButtonBase}" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Grid.Row="1" Content="Clubs" Tag="Clubs" Click="NavigationButton_Click" Style="{StaticResource Atlas.ButtonBase}" HorizontalContentAlignment="Left" Margin="0,0,6,7"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="Advanced Search" Click="AdvancedSearchButton_Click" Style="{StaticResource Atlas.ButtonBase}" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Grid.Row="2" Content="Import Player CSV" Click="ImportPlayerExportButton_Click" Style="{StaticResource Atlas.ButtonBase}" HorizontalContentAlignment="Left" Margin="0,0,6,0"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="Load Game" Command="{Binding LoadGameCommand}" Style="{StaticResource Atlas.PrimaryButton}" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Atlas.Border}" Margin="0,15,0,12"/>
                            <TextBlock Text="DATA STATUS" FontSize="9" Foreground="{StaticResource Atlas.Accent}"/>
                            <TextBlock Text="Live Game Pass connection is read-only. CSV imports remain separate source datasets. Live save editing is blocked until field-level write and read-back verification passes."
                                       FontSize="9" Foreground="{StaticResource Atlas.Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Atlas.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="RECENTLY OPENED" FontSize="9" Foreground="{StaticResource Atlas.Muted}"/>
                            <TextBlock Grid.Column="1" Text="LAST 5 RECORDS" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource Atlas.Subtle}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentlyOpenedProfiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="RecentProfile_Click" Style="{StaticResource Atlas.ButtonBase}" Margin="0,0,8,6" Padding="11,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="{StaticResource Atlas.Text}"/>
                                            <TextBlock Text="{Binding EntityType}" FontSize="8" FontFamily="Consolas" Foreground="{StaticResource Atlas.Accent}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No profiles opened yet. Open a player, staff member or club from Quick Search or its directory."
                                   Visibility="{Binding HasNoRecentlyOpenedProfiles, Converter={StaticResource Atlas.BooleanToVisibility}}"
                                   FontSize="10" Foreground="{StaticResource Atlas.Subtle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding LastAction}" FontSize="10" Foreground="{StaticResource Atlas.Subtle}" Margin="2,15,0,0"/>
            </StackPanel>
        </ScrollViewer>
            </TabItem>
        </TabControl>
        <!-- Blocking live-load overlay: captures mouse and keyboard focus while the snapshot is built. -->
        <Grid x:Name="LiveLoadOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Panel.ZIndex="1000"
              Background="#D608090B"
              Visibility="{Binding IsLiveLoadOverlayVisible, Converter={StaticResource Atlas.BooleanToVisibility}}"
              IsHitTestVisible="True"
              Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="456"
                    MaxWidth="560"
                    Background="#111214"
                    BorderBrush="#4A3025"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="30,27"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="#21140F" BorderBrush="#4B281B" BorderThickness="1">
                            <TextBlock Text="FM" Foreground="{StaticResource Atlas.Accent}" FontFamily="Georgia" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FM ATLAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Atlas.Text}"/>
                            <TextBlock Text="LIVE CAREER CONNECTION" FontSize="8" Foreground="{StaticResource Atlas.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Width="66" Height="66" Margin="0,25,0,17" HorizontalAlignment="Center">
                        <Ellipse Stroke="#343536" StrokeThickness="4" Opacity="0.8"/>
                        <Ellipse x:Name="LoadSpinner"
                                 Stroke="{StaticResource Atlas.Accent}"
                                 StrokeThickness="4"
                                 StrokeDashArray="1.6 2.9"
                                 StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="LoadSpinner"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="FM" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Atlas.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding LiveLoadStage}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource Atlas.Accent}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding LiveLoadDetail}"
                               FontSize="12"
                               Foreground="{StaticResource Atlas.Text}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,9,0,18"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding LiveLoadProgress}"
                                 Height="5"
                                 Background="#303033"
                                 Foreground="{StaticResource Atlas.Accent}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding LiveLoadProgress, StringFormat={}{0}%}"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="{StaticResource Atlas.Muted}"
                               HorizontalAlignment="Center"
                               Margin="0,9,0,0"/>
                    <TextBlock Text="FM Atlas is reading your active career. The main workspace is temporarily locked to prevent incomplete results or accidental actions."
                               FontSize="9"
                               Foreground="{StaticResource Atlas.Subtle}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,17,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
