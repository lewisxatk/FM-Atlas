<Window x:Class="FmAtlas.PlayerIntelligenceReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FM Atlas — Player Intelligence" Height="850" Width="1380" MinHeight="620" MinWidth="950"
        WindowStartupLocation="CenterOwner" Background="#0D1117" Foreground="#E8EEF4" Icon="pack://application:,,,/FmAtlas;component/Assets/FmAtlas.ico">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="#202A35"/><Setter Property="Foreground" Value="#E8EEF4"/><Setter Property="BorderBrush" Value="#303943"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="#303943"/><Setter Property="Background" Value="#111820"/><Setter Property="Foreground" Value="#E8EEF4"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#171F28"/><Setter Property="Foreground" Value="#E8EEF4"/><Setter Property="RowBackground" Value="#171F28"/><Setter Property="AlternatingRowBackground" Value="#202A35"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PLAYER INTELLIGENCE" Foreground="#C6F36B" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="ReportTitle" Text="FM27 live player discovery" FontSize="25" FontWeight="Bold" Margin="0,4,0,2"/>
            <TextBlock x:Name="ReportSummary" Text="Read-only evidence from the selected live scan." Foreground="#9EADB9" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#171F28" BorderBrush="#303943" BorderThickness="1" CornerRadius="18" Padding="9" Margin="0,13,0,10">
            <DockPanel>
                <TextBox x:Name="SearchBox" Width="260" DockPanel.Dock="Left" ToolTip="Search player, field, section or value" TextChanged="FilterChanged"/>
                <ComboBox x:Name="PlayerFilter" Width="190" DockPanel.Dock="Left" SelectionChanged="FilterChanged"/>
                <ComboBox x:Name="SectionFilter" Width="190" DockPanel.Dock="Left" SelectionChanged="FilterChanged"/>
                <Button Content="Show hidden stats" DockPanel.Dock="Left" Click="ShowHidden_Click"/>
                <Button Content="Show all" DockPanel.Dock="Left" Click="ShowAll_Click"/>
                <TextBlock x:Name="VisibleCount" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <DataGrid x:Name="EvidenceGrid" Grid.Row="2" AutoGeneratingColumn="EvidenceGrid_AutoGeneratingColumn"/>
        <TextBlock Grid.Row="3" Text="Read-only evidence viewer · Injury Proneness is listed under Hidden attributes · Unmapped values remain blank · No game memory is modified." Foreground="#9EADB9" FontSize="10" Margin="3,10,0,0"/>
    </Grid>
</Window>
