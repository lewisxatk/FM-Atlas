<Application x:Class="FmAtlas.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Atlas Liquid V8 shared palette. The main window resolves the selected mode at runtime. -->
        <SolidColorBrush x:Key="Atlas.Background" Color="#080F19"/>
        <SolidColorBrush x:Key="Atlas.Surface" Color="#111C2B"/>
        <SolidColorBrush x:Key="Atlas.SurfaceRaised" Color="#1B2A3C"/>
        <SolidColorBrush x:Key="Atlas.Glass" Color="#B817263A"/>
        <SolidColorBrush x:Key="Atlas.GlassBorder" Color="#5AA9C9EA"/>
        <SolidColorBrush x:Key="Atlas.Accent" Color="#79BDEB"/>
        <SolidColorBrush x:Key="Atlas.Text" Color="#E8F0FA"/>
        <SolidColorBrush x:Key="Atlas.Muted" Color="#91A4BA"/>
        <SolidColorBrush x:Key="Atlas.Warning" Color="#E5BD72"/>
        <SolidColorBrush x:Key="Atlas.Danger" Color="#F18EAA"/>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#F0132032"/>
            <Setter Property="Foreground" Value="#F1F6FC"/>
            <Setter Property="BorderBrush" Value="#75A9C9EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MaxWidth" Value="340"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Application.Resources>
</Application>
