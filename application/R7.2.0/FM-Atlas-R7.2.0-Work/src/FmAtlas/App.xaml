<Application x:Class="FmAtlas.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <!-- MONOLITH Obsidian tokens are applied at application startup; these defaults
       keep the first WPF frame aligned before the theme service finishes loading. -->
  <SolidColorBrush x:Key="Bg" Color="#101216"/>
  <SolidColorBrush x:Key="Panel" Color="#1B1F25"/>
  <SolidColorBrush x:Key="PanelRaised" Color="#252A32"/>
  <SolidColorBrush x:Key="Accent" Color="#F28A36"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#F1F2F3"/>
  <SolidColorBrush x:Key="Muted" Color="#9299A3"/>
  <SolidColorBrush x:Key="Border" Color="#343A43"/>
  <SolidColorBrush x:Key="Warning" Color="#E6C477"/>
  <SolidColorBrush x:Key="Danger" Color="#F08C96"/>
 </Application.Resources>
</Application>
